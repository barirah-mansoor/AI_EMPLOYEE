# AI Employee - Environment Variables
# Copy this to .env and fill in your actual credentials
# IMPORTANT: Add .env to .gitignore to prevent committing credentials

# Gmail API Credentials
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_ACCESS_TOKEN=your_access_token_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# Social Media API Keys
LINKEDIN_API_KEY=your_linkedin_api_key_here
TWITTER_API_KEY=your_twitter_api_key_here
FACEBOOK_PAGE_TOKEN=your_facebook_page_token_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Banking API Credentials (Example)
BANK_API_KEY=your_bank_api_key_here
BANK_ACCOUNT_ID=your_account_id_here

# WhatsApp Session Path
WHATSAPP_SESSION_PATH=/secure/path/to/whatsapp/session

# Claude Code Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# Database Credentials (if using)
DATABASE_URL=postgresql://username:password@localhost/dbname

# Security Settings
ENCRYPTION_KEY=your_encryption_key_here
MAX_APPROVAL_AMOUNT=500.00
DEV_MODE=false

# Logging
LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=90
